# Ratatosk Docker Compose Environment Variables
# Copy this file to .env and adjust values for your deployment.

# ─── Server Configuration ───────────────────────────────────────────
# Base domain for tunnel subdomains (requires wildcard DNS: *.tunnel.example.com)
RATATOSK_BASE_DOMAIN=localhost

# Port for the public HTTP(S) proxy (use 443 with TLS in production)
RATATOSK_PUBLIC_PORT=8080

# Port and credentials for the admin dashboard and API. Set real credentials;
# blank values intentionally prevent the production server template starting.
RATATOSK_ADMIN_PORT=8081
RATATOSK_ADMIN_USERNAME=
RATATOSK_ADMIN_PASSWORD=
RATATOSK_ADMIN_TLS_CERT_FILE=
RATATOSK_ADMIN_TLS_KEY_FILE=

# Port for the TCP control plane (CLI clients connect here). Remote control
# requires TLS and exactly one token source. For a file, create
# ./secrets/control-token and set the container path shown below.
RATATOSK_CONTROL_PORT=7000
RATATOSK_CONTROL_TOKEN=
RATATOSK_CONTROL_TOKEN_FILE=
# RATATOSK_CONTROL_TOKEN_FILE=/run/secrets/control-token

# Optional dedicated control certificate paths inside the container. Put files
# under ./secrets. Leave both blank to reuse public manual or CertMagic TLS.
RATATOSK_CONTROL_TLS_CERT_FILE=
RATATOSK_CONTROL_TLS_KEY_FILE=
RATATOSK_CONTROL_SERVER_NAME=tunnel.example.com
RATATOSK_CONTROL_CA_FILE=

# Public TLS. Manual certificate paths refer to files under /run/secrets.
RATATOSK_TLS_ENABLED=false
RATATOSK_TLS_CERT_FILE=
RATATOSK_TLS_KEY_FILE=

# Automatic TLS (Let's Encrypt via DNS-01 challenge, mutually exclusive with TLS_ENABLED)
RATATOSK_TLS_AUTO=false
RATATOSK_TLS_EMAIL=
RATATOSK_TLS_PROVIDER=
RATATOSK_TLS_API_TOKEN=

# ─── Client Configuration ───────────────────────────────────────────
# Relay server address for the CLI client (host:port)
RATATOSK_SERVER=tunnel.example.com:7000
# Remote addresses automatically require verified TLS. Set this to true only
# when TLS must also be forced for a loopback relay.
RATATOSK_CONTROL_TLS_ENABLED=true

# Local port to expose through the tunnel
RATATOSK_PORT=3000

# Optional: HTTP Basic Auth for tunnel visitors (format: user:pass)
RATATOSK_BASIC_AUTH=

# Optional: Enable streamer mode to redact sensitive data from logs
RATATOSK_STREAMER=false
