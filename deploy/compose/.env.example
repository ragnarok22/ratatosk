# Ratatosk Docker Compose Environment Variables
# Copy this file to .env and adjust values for your deployment.

# ─── Server Configuration ───────────────────────────────────────────
# Base domain for tunnel subdomains (requires wildcard DNS: *.tunnel.example.com)
RATATOSK_BASE_DOMAIN=localhost

# Port for the public HTTP(S) proxy (use 443 with TLS in production)
RATATOSK_PUBLIC_PORT=8080

# Port for the admin dashboard and API
RATATOSK_ADMIN_PORT=8081
RATATOSK_ADMIN_USERNAME=admin
RATATOSK_ADMIN_PASSWORD=replace-with-a-long-random-password

# Port for the TCP control plane (CLI clients connect here)
RATATOSK_CONTROL_PORT=7000
RATATOSK_CONTROL_TOKEN=replace-with-a-long-random-token

# The remote control plane always uses verified TLS. These host files must
# contain a certificate valid for RATATOSK_CONTROL_SERVER_NAME and its key.
RATATOSK_CONTROL_TLS_CERT_HOST_PATH=/etc/letsencrypt/live/tunnel.example.com/fullchain.pem
RATATOSK_CONTROL_TLS_KEY_HOST_PATH=/etc/letsencrypt/live/tunnel.example.com/privkey.pem
RATATOSK_CONTROL_SERVER_NAME=tunnel.example.com
RATATOSK_CONTROL_CA_FILE=
RATATOSK_CONTROL_CA_HOST_PATH=

# TLS Configuration (set to true for production with valid certs)
RATATOSK_TLS_ENABLED=false
RATATOSK_TLS_CERT_FILE=
RATATOSK_TLS_KEY_FILE=

# Automatic TLS (Let's Encrypt via DNS-01 challenge, mutually exclusive with TLS_ENABLED)
RATATOSK_TLS_AUTO=false
RATATOSK_TLS_EMAIL=
RATATOSK_TLS_PROVIDER=
RATATOSK_TLS_API_TOKEN=

# ─── Client Configuration ───────────────────────────────────────────
# Relay server address for the CLI client (host:port)
RATATOSK_SERVER=tunnel.example.com:7000
RATATOSK_CONTROL_TLS_ENABLED=true

# Local port to expose through the tunnel
RATATOSK_PORT=3000

# Optional: HTTP Basic Auth for tunnel visitors (format: user:pass)
RATATOSK_BASIC_AUTH=

# Optional: Enable streamer mode to redact sensitive data from logs
RATATOSK_STREAMER=false
