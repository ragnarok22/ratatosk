# Ratatosk Relay Server Configuration
# Copy this file to one of the following locations:
#   /etc/ratatosk/ratatosk.yaml  (system-wide)
#   ~/.ratatosk/ratatosk.yaml    (user-level)
#   ./ratatosk.yaml              (current directory)
#
# All values can also be set via environment variables with the RATATOSK_ prefix.
# Example: RATATOSK_BASE_DOMAIN=tunnel.example.com

# The base domain used for generating tunnel subdomains.
# Each tunnel gets a URL like: <subdomain>.<base_domain>
# For local development, "localhost" works fine.
# For production, set this to your wildcard DNS domain (e.g., "tunnel.example.com").
base_domain: localhost

# Port for the public HTTP(S) proxy that routes traffic to tunnels.
# In production with TLS, set this to 443.
public_port: 8080

# Keep admin local-only unless browser authentication is configured.
admin_host: 127.0.0.1
admin_port: 8081
# Required when admin_host is not a loopback address.
admin_username: ""
admin_password: ""
admin_tls_enabled: false
admin_tls_cert_file: ""
admin_tls_key_file: ""

# Keep the control plane local-only for plaintext development. A non-loopback
# binding requires TLS and exactly one of control_token or control_token_file.
control_host: 127.0.0.1
control_port: 7000
control_token: ""
control_token_file: ""
control_tls_enabled: false

# A dedicated control-plane certificate is optional. Configure both files or
# neither. When omitted, control TLS reuses the public manual certificate or
# the certificate managed by CertMagic (tls_auto).
control_tls_cert_file: ""
control_tls_key_file: ""

# TLS Configuration
# Enable TLS for the public proxy. Requires a valid certificate and key.
# For wildcard subdomains, you need a wildcard certificate (e.g., *.tunnel.example.com).
# You can obtain one for free using Let's Encrypt with a DNS-01 challenge.
tls_enabled: false

# Path to the TLS certificate file (PEM format).
# For Let's Encrypt: /etc/letsencrypt/live/tunnel.example.com/fullchain.pem
tls_cert_file: ""

# Path to the TLS private key file (PEM format).
# For Let's Encrypt: /etc/letsencrypt/live/tunnel.example.com/privkey.pem
tls_key_file: ""

# Automatic TLS Configuration (via Let's Encrypt DNS-01 challenge)
# When enabled, certmagic automatically provisions and renews wildcard certificates.
# This is mutually exclusive with tls_enabled (manual TLS).
tls_auto: false

# Email address for Let's Encrypt account registration.
# Required when tls_auto is enabled.
tls_email: ""

# DNS provider for solving DNS-01 challenges.
# Currently supported: "cloudflare"
# Required when tls_auto is enabled.
tls_provider: ""

# API token for the DNS provider.
# For Cloudflare: create a token with Zone:DNS:Edit permissions.
# Required when tls_auto is enabled.
# Best practice: set via RATATOSK_TLS_API_TOKEN environment variable instead of config file.
tls_api_token: ""

# Dynamic public port range for TCP and UDP tunnels (end is exclusive).
port_range_start: 10000
port_range_end: 20000
